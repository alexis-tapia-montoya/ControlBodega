<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/txtTituloLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceso a Bodega"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edtUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Sesión"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnBiometrico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresar con Reconocimiento Facial"
            android:backgroundTint="#00796B"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Operarios (Solo Admin)"
            android:textStyle="bold"
            android:textColor="#757575"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/edtClaveAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clave de Administrador"
            android:inputType="textPassword"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnRegistrarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Registrar Usuario"
            android:backgroundTint="#607D8B"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnRegistrarRostro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Escanear y Asociar Rostro"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txtMensajeLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:layout_marginTop="12dp" />

        <androidx.camera.view.PreviewView
            android:id="@+id/previewCamara"
            android:layout_width="180dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>